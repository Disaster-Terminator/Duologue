#!/bin/sh
set -eu

if [ "${BRIDGE_SKIP_GIT_HOOKS:-}" = "1" ]; then
  exit 0
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "Duologue pre-push: pnpm is not on PATH; refusing to skip local gate silently." >&2
  echo "Install pnpm or set BRIDGE_SKIP_GIT_HOOKS=1 for an explicit local bypass." >&2
  exit 1
fi

echo "Duologue pre-push: running local deterministic gate..."
pnpm run gate:local
